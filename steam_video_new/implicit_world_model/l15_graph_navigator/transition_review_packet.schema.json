{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wuxiyang1996/steam_video/transition_review_packet.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "annotation_status", "labels_source", "annotator", "locked_sha256", "source_dataset_sha256", "source_case_set_sha256", "output_contract", "instructions", "items"],
  "properties": {
    "schema_version": {"const": "steam-transition-review-packet/v0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "annotation_status": {"enum": ["unreviewed", "ai_provisional", "human_locked"]},
    "labels_source": {"enum": [null, "model_provisional", "independent_human"]},
    "annotator": {"type": ["string", "null"]},
    "locked_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_case_set_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_contract": {"const": "categorical_only_no_numeric_judgments"},
    "instructions": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "items": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/item"}}
  },
  "$defs": {
    "action": {
      "type": "object", "additionalProperties": false,
      "required": ["action_type", "source_id", "target_ids", "relation"],
      "properties": {
        "action_type": {"type": "string"},
        "source_id": {"type": ["string", "null"]},
        "target_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "relation": {"type": ["string", "null"]}
      }
    },
    "annotation": {
      "type": "object", "additionalProperties": false,
      "required": ["review_decision", "observation_validity", "action_execution_validity", "belief_delta_validity", "relation_outcome", "evidence_refs", "rationale"],
      "properties": {
        "review_decision": {"enum": [null, "accept", "reject"]},
        "observation_validity": {"enum": [null, "valid", "invalid", "inconclusive"]},
        "action_execution_validity": {"enum": [null, "valid", "invalid", "inconclusive"]},
        "belief_delta_validity": {"enum": [null, "valid", "invalid", "inconclusive"]},
        "relation_outcome": {"enum": [null, "supports", "rejects", "inconclusive", "not_applicable"]},
        "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "rationale": {"type": "string"}
      }
    },
    "item": {
      "type": "object", "additionalProperties": false,
      "required": ["item_id", "question", "belief_before", "action", "visible_context", "executed_result", "annotation"],
      "properties": {
        "item_id": {"type": "string", "minLength": 1},
        "question": {"type": "string", "minLength": 1},
        "belief_before": {
          "type": "object", "additionalProperties": false,
          "required": ["missing_roles", "contradictions", "answerability"],
          "properties": {
            "missing_roles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "contradictions": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "answerability": {"enum": ["not_ready", "ready", "abstain"]}
          }
        },
        "action": {"$ref": "#/$defs/action"},
        "visible_context": {
          "type": "object", "additionalProperties": false,
          "required": ["nodes"],
          "properties": {"nodes": {"type": "array", "items": {"type": "object"}}}
        },
        "executed_result": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "real_observation_ids", "evidence_refs", "observation_outcome", "grounded_empty_result"],
          "properties": {
            "status": {"type": "string"},
            "real_observation_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "observation_outcome": {"enum": ["observed", "empty_search_observed", "empty"]},
            "grounded_empty_result": {"type": "boolean"}
          }
        },
        "annotation": {"$ref": "#/$defs/annotation"}
      }
    }
  }
}
