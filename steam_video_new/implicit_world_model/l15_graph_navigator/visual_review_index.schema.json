{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "steam-visual-transition-review/v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_id", "packet_sha256", "output_contract", "items"],
  "properties": {
    "schema_version": {"const": "steam-visual-transition-review/v0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "packet_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_contract": {"const": "outcome_blind_visual_evidence_only"},
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "coverage", "visual_evidence"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "coverage": {"enum": ["full", "partial", "none"]},
          "visual_evidence": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["asset_id", "node_id", "roles", "video_id", "start_s", "end_s", "media_url", "availability", "missing_reason"],
              "properties": {
                "asset_id": {"type": "string", "pattern": "^visual:[0-9a-f]{24}$"},
                "node_id": {"type": "string", "minLength": 1},
                "roles": {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {"enum": ["source", "target", "observation", "context"]}
                },
                "video_id": {"type": "string", "minLength": 1},
                "start_s": {"type": ["number", "null"], "minimum": 0},
                "end_s": {"type": ["number", "null"], "exclusiveMinimum": 0},
                "media_url": {"type": ["string", "null"]},
                "availability": {"enum": ["available", "missing"]},
                "missing_reason": {"type": ["string", "null"]}
              }
            }
          }
        }
      }
    }
  }
}
