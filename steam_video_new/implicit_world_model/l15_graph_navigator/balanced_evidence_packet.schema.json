{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wuxiyang1996/steam_video/balanced_evidence_packet.schema.json",
  "title": "BalancedReasoningEvidencePacket",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "packet_id", "annotation_status", "labels_source",
    "annotator", "locked_sha256", "source_review_queue_sha256",
    "output_contract", "instructions", "items"
  ],
  "properties": {
    "schema_version": {"const": "steam-balanced-evidence-packet/v0.1"},
    "packet_id": {"type": "string", "minLength": 1},
    "annotation_status": {"enum": ["unreviewed", "ai_provisional", "human_locked"]},
    "labels_source": {"enum": [null, "model_provisional", "independent_human"]},
    "annotator": {"type": ["string", "null"]},
    "locked_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_review_queue_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "output_contract": {"const": "categorical_only_no_numeric_judgments"},
    "instructions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["item_id", "stratum", "query", "evidence", "annotation"],
        "properties": {
          "item_id": {"type": "string", "minLength": 1},
          "stratum": {
            "enum": [
              "delayed_two_hop", "identity", "state", "contradiction",
              "counterevidence", "blocked_path_recovery", "ambiguity_abstention"
            ]
          },
          "query": {"type": "object"},
          "evidence": {"type": "object"},
          "annotation": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "review_decision", "verifier_outcome", "evidence_chain_valid",
              "first_action_valid", "delayed_effect", "evidence_refs", "rationale"
            ],
            "properties": {
              "review_decision": {"enum": ["accept", "reject", null]},
              "verifier_outcome": {"enum": ["supports", "rejects", "inconclusive", "not_applicable", null]},
              "evidence_chain_valid": {"type": ["boolean", "null"]},
              "first_action_valid": {"type": ["boolean", "null"]},
              "delayed_effect": {"enum": ["yes", "no", "not_applicable", null]},
              "evidence_refs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
              "rationale": {"type": "string"}
            }
          }
        }
      }
    }
  }
}
