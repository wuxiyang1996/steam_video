{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wuxiyang1996/steam_video/balanced_case_review.schema.json",
  "title": "BalancedReasoningCaseReviewQueue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "queue_id", "annotation_status", "annotator",
    "locked_sha256", "source_case_set_id",
    "allowed_verifier_outcomes", "instructions", "reviews"
  ],
  "properties": {
    "schema_version": {"const": "steam-balanced-case-review/v0.1"},
    "queue_id": {"type": "string", "minLength": 1},
    "annotation_status": {"enum": ["unreviewed", "ai_provisional", "human_locked"]},
    "annotator": {"type": ["string", "null"]},
    "locked_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "source_case_set_id": {"type": "string", "minLength": 1},
    "allowed_verifier_outcomes": {
      "type": "array",
      "items": {"enum": ["supports", "rejects", "inconclusive", "not_applicable"]},
      "uniqueItems": true
    },
    "instructions": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "reviews": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "review_id", "category", "case", "candidate_basis",
          "review_decision", "verifier_outcome", "evidence_chain_valid",
          "first_action_valid", "delayed_effect", "rationale"
        ],
        "properties": {
          "review_id": {"type": "string", "minLength": 1},
          "category": {
            "enum": [
              "delayed_two_hop", "identity", "state", "contradiction",
              "counterevidence", "blocked_path_recovery", "ambiguity_abstention"
            ]
          },
          "case": {
            "type": "object",
            "required": [
              "case_id", "overlay_path", "overlay_id", "question",
              "seed_event_ids", "missing_roles", "graph_read_budget",
              "gold_event_ids", "acceptable_first_actions", "tags"
            ]
          },
          "candidate_basis": {"type": "array", "items": {"type": "string"}, "minItems": 1},
          "review_decision": {"enum": ["accept", "reject", null]},
          "verifier_outcome": {"enum": ["supports", "rejects", "inconclusive", "not_applicable", null]},
          "evidence_chain_valid": {"type": ["boolean", "null"]},
          "first_action_valid": {"type": ["boolean", "null"]},
          "delayed_effect": {"enum": ["yes", "no", "not_applicable", null]},
          "rationale": {"type": "string"}
        }
      }
    }
  }
}
