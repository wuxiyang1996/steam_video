{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/wuxiyang1996/steam_video/memory_graph/atomic_event.schema.json",
  "title": "AtomicEvent",
  "description": "One L1.5 event hypothesis grounded in immutable L1 observation nodes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "video_id",
    "time_span",
    "predicate",
    "evidence_refs",
    "confidence",
    "participants",
    "states",
    "provenance"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "time_span": {
      "$ref": "#/$defs/time_span"
    },
    "predicate": {
      "type": "string",
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "participants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity_mention"
      }
    },
    "states": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/state_assertion"
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "producer",
        "model",
        "layer"
      ],
      "properties": {
        "producer": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "layer": {
          "const": "L1.5"
        }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "time_span": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start_s",
        "end_s"
      ],
      "properties": {
        "start_s": {
          "type": "number",
          "minimum": 0
        },
        "end_s": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "entity_mention": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mention_id",
        "role",
        "entity_type",
        "surface",
        "confidence",
        "grounding_refs"
      ],
      "properties": {
        "mention_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "entity_type": {
          "type": "string",
          "minLength": 1
        },
        "surface": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "grounding_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "state_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mention_id",
        "attribute",
        "value",
        "polarity",
        "confidence"
      ],
      "properties": {
        "mention_id": {
          "type": "string",
          "minLength": 1
        },
        "attribute": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        },
        "polarity": {
          "enum": [
            "positive",
            "negative"
          ]
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    }
  }
}
